{
  "manifest_version": 3,
  "name": "L2wap Bot",
  "version": "20.24",
  "description": "L2wap Bot 20.24 — Маммон, навыки и учёт поражений",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://l2wap.com/*",
    "https://*.l2wap.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "L2wap Bot",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://l2wap.com/*",
        "https://*.l2wap.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://l2wap.com/*",
        "https://*.l2wap.com/*"
      ],
      "js": [
        "notranslate.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://l2wap.com/*",
        "https://*.l2wap.com/*"
      ],
      "js": [
        "defaults.js",
        "skills-il.js",
        "zone-db.js",
        "zone-kpd.js",
        "buff-value.js",
        "fa-full.js",
        "augment.js",
        "battle-cooldown.js",
        "engine-core.js",
        "modules/fishing.js",
        "modules/epics.js",
        "modules/raid.js",
        "modules/combat.js",
        "modules/dungeons.js",
        "modules/tvt.js",
        "modules/mobfarm.js",
        "modules/quests.js",
        "modules/navigation.js",
        "modules/buffs.js",
        "modules/equipment.js",
        "modules/economy.js",
        "modules/resources.js",
        "modules/loot.js",
        "modules/survival.js",
        "modules/mammon.js",
        "modules/story.js",
        "modules/fightlab.js",
        "modules/pvp.js",
        "modules/enemies.js",
        "modules/tvtshop.js",
        "modules/dailies.js",
        "modules/champs.js",
        "modules/rbtimer.js",
        "modules/rbrun.js",
        "modules/subclass.js",
        "modules/enchant.js",
        "modules/lifestone.js",
        "modules/warlock.js",
        "modules/actions.js",
        "modules/payments.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-bot": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Старт/стоп бота"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "icons/*",
        "items-il.json",
        "mammon-gear.json",
        "enchant-ui.js",
        "enchant-ui.css",
        "modules/enchant.js",
        "modules/lifestone.js",
        "modules/warlock.js",
        "warlock-ui.js",
        "warlock-ui.css",
        "pvp-ui.js",
        "pvp-ui.css"
      ],
      "matches": [
        "https://l2wap.com/*",
        "https://*.l2wap.com/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116",
  "version_name": "20.24"
}
