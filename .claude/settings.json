{
  "permissions": {
    "allow": [
      "Edit(hook.js)",
      "Edit(content.js)",
      "Edit(modules/combat.js)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/superpowers-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
